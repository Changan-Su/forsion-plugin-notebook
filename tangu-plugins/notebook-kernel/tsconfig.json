{
  "comment": "只做类型检查(noEmit);产物由仓根 build.mjs 用 esbuild 打成 dist/index.js 一个文件(要把仓根 src/nb.ts 带进来)。对 @forsion/tangu-agent 仅 import type:verbatimModuleSyntax=true 把任何【值导入】核心变成编译错误(插件绝不复制核心模块图)。dist/ 已提交,装包免构建。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": {
      "@forsion/tangu-agent": ["./types/tangu-agent.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
